# Copie en .env pour le dev local, et renseigne les mêmes clés dans
# Vercel → Project Settings → Environment Variables (Production + Preview).

SUPABASE_URL=https://gsvazsseceadhpexfqbo.supabase.co

# Clé publique "anon" — déjà utilisée dans ta page de login actuelle.
SUPABASE_ANON_KEY=colle_ici_ta_cle_anon_publique

# Clé "service_role" — Project Settings → API → service_role.
# ⚠️ SECRET absolu : ne jamais la préfixer NEXT_PUBLIC_/VITE_/REACT_APP_,
# ne jamais la commiter, ne jamais l'envoyer au navigateur. Elle contourne
# toutes les policies RLS.
SUPABASE_SERVICE_ROLE_KEY=colle_ici_ta_cle_service_role

NODE_ENV=production
